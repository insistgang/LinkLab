      "aiResponse": {
        "type": "ocr",
        "text": "今日特推：紅燒肉38元，清蒸鱸魚58元，麻婆豆腐22元",
        "action": "need_volunteer"
      },
      "volunteerResponse": {
        "volunteerId": "volunteer_002",
        "volunteerName": "王芳",
        "guidance": "菜單上還有時令蔬菜、湯品等。您想喫什麼類型的菜？我可以詳細介紹。"
      }
    },
    {
      "id": "scenario_005",
      "title": "SOS緊急求助",
      "category": "emergency",

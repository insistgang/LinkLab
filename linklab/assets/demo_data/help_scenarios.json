      "volunteerResponse": {
        "volunteerId": "volunteer_001",
        "volunteerName": "李明",
        "guidance": "您現在面向北方，往前走20米，右手邊就是地鐵站A口。我引導您過去。"
      }
    },
    {
      "id": "scenario_003",
      "title": "顏色識別",
      "category": "daily",
      "description": "用戶需要識別衣服顏色",
      "userInput": "這件衣服是什麼顏色？",
      "aiResponse": {
        "type": "color_recognition",
        "text": "這是深藍色，類似於海軍藍",
        "action": "ai_resolved"
      }
    },
    {
      "id": "scenario_004",
      "title": "餐廳點餐",

{
  "scenarios": [
    {
      "id": "scenario_001",
      "title": "药品识别",
      "category": "daily",
      "description": "用户需要识别药品说明书",
      "userInput": "帮我看一下这个药怎么吃",
      "aiResponse": {
        "type": "ocr",
        "text": "阿莫西林胶囊，规格0.25g，成人每次2粒，每6-8小时一次",
        "action": "ai_resolved"
      }
    },
    {
      "id": "scenario_002",
      "title": "街道导航",
      "category": "navigation",
      "description": "用户在陌生街道需要导航帮助",
      "userInput": "我在哪里？怎么去地铁站？",
      "aiResponse": {
        "type": "scene_description",
        "text": "您在一条城市街道，前方20米处有地铁站入口",
        "action": "need_volunteer"
      },
      "volunteerResponse": {
        "volunteerId": "volunteer_001",
        "volunteerName": "李明",
        "guidance": "您现在面向北方，往前走20米，右手边就是地铁站A口。我引导您过去。"
      }
    },
    {
      "id": "scenario_003",
      "title": "颜色识别",
      "category": "daily",
      "description": "用户需要识别衣服颜色",
      "userInput": "这件衣服是什么颜色？",
      "aiResponse": {
        "type": "color_recognition",
        "text": "这是深蓝色，类似于海军蓝",
        "action": "ai_resolved"
      }
    },
    {
      "id": "scenario_004",
      "title": "餐厅点餐",
      "category": "daily",
      "description": "用户在餐厅需要看菜单",
      "userInput": "帮我读一下菜单",
      "aiResponse": {
        "type": "ocr",
        "text": "今日特推：红烧肉38元，清蒸鲈鱼58元，麻婆豆腐22元",
        "action": "need_volunteer"
      },
      "volunteerResponse": {
        "volunteerId": "volunteer_002",
        "volunteerName": "王芳",
        "guidance": "菜单上还有时令蔬菜、汤品等。您想吃什么类型的菜？我可以详细介绍。"
      }
    },
    {
      "id": "scenario_005",
      "title": "SOS紧急求助",
      "category": "emergency",
      "description": "用户遇到紧急情况",
      "userInput": "救命！我摔倒了，腿很痛",
      "aiResponse": {
        "type": "emergency",
        "text": "检测到紧急情况！正在为您联系志愿者和紧急联系人",
        "action": "sos_triggered"
      },
      "volunteerResponse": {
        "volunteerId": "volunteer_005",
        "volunteerName": "陈静",
        "guidance": "我是陈静，已经收到您的求助。请保持冷静，告诉我您的具体位置，我马上过来。"
      }
    },
    {
      "id": "scenario_006",
      "title": "公交站查询",
      "category": "navigation",
      "description": "用户需要确认公交线路",
      "userInput": "这是几路车？到不到人民公园？",
      "aiResponse": {
        "type": "ocr",
        "text": "101路公交车，下一站是人民公园",
        "action": "ai_resolved"
      }
    }
  ],
  "demoFlow": {
    "steps": [
      {
        "step": 1,
        "screen": "home",
        "action": "点击大按钮开始求助",
        "delay": 1000
      },
      {
        "step": 2,
        "screen": "ai_chat",
        "action": "AI问候语",
        "aiMessage": "您好！我是您的智能助手，有什么可以帮助您的吗？",
        "delay": 1500
      },
      {
        "step": 3,
        "screen": "ai_chat",
        "action": "用户选择场景或输入",
        "userMessage": "帮我看一下这个药怎么吃",
        "delay": 2000
      },
      {
        "step": 4,
        "screen": "ai_chat",
        "action": "AI识别并回复",
        "aiMessage": "这是阿莫西林胶囊，每粒0.25克。成人每次服用2粒，每6到8小时一次。",
        "delay": 2000
      },
      {
        "step": 5,
        "screen": "ai_chat",
        "action": "询问是否需要进一步帮助",
        "aiMessage": "还有其他需要我帮助的吗？",
        "delay": 1500
      },
      {
        "step": 6,
        "screen": "ai_chat",
        "action": "用户请求连接志愿者",
        "userMessage": "我想问更详细的问题",
        "delay": 1000
      },
      {
        "step": 7,
        "screen": "matching",
        "action": "进入匹配页面",
        "matchingTime": 3000,
        "delay": 3500
      },
      {
        "step": 8,
        "screen": "call",
        "action": "连接志愿者",
        "volunteerName": "李明",
        "callDuration": 15000,
        "delay": 16000
      },
      {
        "step": 9,
        "screen": "rating",
        "action": "通话结束，进入评价",
        "delay": 3000
      },
      {
        "step": 10,
        "screen": "home",
        "action": "返回首页",
        "delay": 1000
      }
    ]
  }
}

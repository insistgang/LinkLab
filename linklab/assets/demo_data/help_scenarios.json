      },
      "volunteerResponse": {
        "volunteerId": "volunteer_005",
        "volunteerName": "陳靜",
        "guidance": "我是陳靜，已經收到您的求助。請保持冷靜，告訴我您的具體位置，我馬上過來。"
      }
    },
    {
      "id": "scenario_006",
      "title": "公交站查詢",
      "category": "navigation",
      "description": "用戶需要確認公交線路",

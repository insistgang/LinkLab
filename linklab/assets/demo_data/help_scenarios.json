      },
      {
        "step": 2,
        "screen": "ai_chat",
        "action": "AI問候語",
        "aiMessage": "您好！我是您的智能助手，有什麼可以幫助您的嗎？",
        "delay": 1500
      },
      {
        "step": 3,
        "screen": "ai_chat",
        "action": "用戶選擇場景或輸入",
        "userMessage": "幫我看一下這個藥怎麼喫",
        "delay": 2000
      },
      {
        "step": 4,
        "screen": "ai_chat",
        "action": "AI識別並回復",
        "aiMessage": "這是阿莫西林膠囊，每粒0.25克。成人每次服用2粒，每6到8小時一次。",
        "delay": 2000
      },
      {
        "step": 5,
        "screen": "ai_chat",
        "action": "詢問是否需要進一步幫助",
        "aiMessage": "還有其他需要我幫助的嗎？",
        "delay": 1500
      },
      {
        "step": 6,
        "screen": "ai_chat",
        "action": "用戶請求連接志願者",
        "userMessage": "我想問更詳細的問題",
        "delay": 1000
      },
      {
        "step": 7,
        "screen": "matching",
        "action": "進入匹配頁面",
        "matchingTime": 3000,
        "delay": 3500
      },
      {
        "step": 8,
        "screen": "call",
        "action": "連接志願者",
        "volunteerName": "李明",
        "callDuration": 15000,
        "delay": 16000
      },
      {
        "step": 9,
        "screen": "rating",
        "action": "通話結束，進入評價",
        "delay": 3000
      },
      {
        "step": 10,
        "screen": "home",
        "action": "返回首頁",
        "delay": 1000
      }
    ]
